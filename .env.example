# Smart Health — Environment Variables Template
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secret values.
#
# See docs/ARCHITECTURE.md and docs/Setup.md for setup instructions.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Public client credentials (accessible to browser bundle):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL database connection URL (Used by Drizzle ORM and migrations):
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Note: For serverless / pooled connections, port 6543 with ?pgbouncer=true can be used.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Server-only service role key (Never expose to browser bundle):
# Required for privileged seed scripts or server-side administrative overrides.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── LLM Provider (Phase 4+) ───────────────────────────────────────────────────
# The app works without an LLM key; template-based fallback notifications are used.
# Set to: "google" | "openai" | "anthropic"
LLM_PROVIDER=
LLM_API_KEY=

# ── Optional Integrations (Phase 4+, Optional) ────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
